# Which model provider to use: "meta" (Meta Model API, Muse Spark) or "fireworks" (Muse Spark Open on Fireworks AI).
CUST_PROVIDER=meta

# Meta Model API key from dev.meta.ai (Model API dashboard -> API keys).
MODEL_API_KEY=

# Only needed when CUST_PROVIDER=fireworks.
FIREWORKS_API_KEY=

# Optional: low, medium, high, or xhigh. Muse Spark Open defaults to xhigh, which is slow;
# "medium" is a good starting point for agent loops. Leave empty for the provider default.
CUST_REASONING_EFFORT=

# Maximum output tokens per model call, shared by reasoning and the answer. 8192 suits "medium"
# reasoning; raise it if you see "used all output tokens on reasoning" errors.
CUST_MAX_TOKENS=8192

# Optional overrides. Defaults: muse-spark-1.3 on Meta, accounts/fireworks/models/muse-spark-open on Fireworks.
# CUST_MODEL=
# CUST_BASE_URL=

# A GitHub token. Read-only scopes are enough for dry runs; posting with --apply needs
# "Issues: read and write" on the target repository.
GITHUB_TOKEN=

# Test commands the reproduction agent may run, separated by ';'.
CUST_ALLOWED_COMMANDS=pytest;python -m pytest
CUST_COMMAND_TIMEOUT=180
CUST_MAX_STEPS=15

# Webhook server only.
# GITHUB_WEBHOOK_SECRET=
# CUST_APPLY=0