# Which model provider to use: "meta" (Meta Model API, Muse Spark) or "baseten" (Muse Spark Open).
GK_PROVIDER=meta

# Meta Model API key from dev.meta.ai (Model API dashboard -> API keys).
MODEL_API_KEY=

# Only needed when GK_PROVIDER=baseten.
BASETEN_API_KEY=

# Optional overrides. Defaults: muse-spark-1.3 on Meta, meta-models/muse-spark-open-1026 on Baseten.
# GK_MODEL=
# GK_BASE_URL=

# A GitHub token. Read-only scopes are enough for dry runs; posting with --apply needs
# "Issues: read and write" on the target repository.
GITHUB_TOKEN=

# Test commands the reproduction agent may run, separated by ';'.
GK_ALLOWED_COMMANDS=pytest;python -m pytest
GK_COMMAND_TIMEOUT=180
GK_MAX_STEPS=15

# Webhook server only.
# GITHUB_WEBHOOK_SECRET=
# GK_APPLY=0